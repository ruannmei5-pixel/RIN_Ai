# Contoh file environment variable untuk RIN.
# Salin file ini menjadi ".env" jika diperlukan pada phase-phase berikutnya.
# Jangan pernah mengisi ".env" asli dengan secret dan meng-commit-nya ke Git.

# Contoh (belum digunakan pada Phase 1, disiapkan untuk phase mendatang):
# RIN_OLLAMA_HOST=http://localhost:11434
# RIN_OLLAMA_MODEL=qwen3:4b

# ---------------------------------------------------------------------
# AUTOMATIC WEB SEARCH (Tavily)
# ---------------------------------------------------------------------
# Wajib diisi jika ingin fitur web search otomatis aktif.
# Cara membuat API key:
#   1. Buka https://tavily.com dan buat akun (free tier tersedia).
#   2. Ambil API key dari dashboard (biasanya diawali "tvly-").
#   3. Salin file ini menjadi ".env" (JANGAN commit file ".env" ke Git —
#      sudah otomatis diabaikan lewat .gitignore).
#   4. Isi baris di bawah ini dengan API key Anda.
#
# Jika baris ini kosong/tidak ada, RIN akan otomatis fallback ke Ollama
# tanpa web search (lihat app/services/web_search.py) — TIDAK akan crash.
TAVILY_API_KEY=

# ---------------------------------------------------------------------
# TAHAP 3 — MULTI AI PROVIDER
# ---------------------------------------------------------------------
# RIN dapat memakai beberapa AI inference provider: Ollama (lokal),
# NVIDIA AI, dan OpenRouter. Tavily di atas TETAP hanya untuk web
# search — bukan AI inference provider (jangan dicampur).
#
# AI_PROVIDER menentukan provider mana yang dipakai untuk chat.
# Nilai yang diperbolehkan: ollama | nvidia | openrouter
AI_PROVIDER=nvidia

# Jika provider yang dipilih di atas gagal (timeout/unavailable/API
# error/auth error), RIN dapat otomatis memakai provider fallback ini.
# Status fallback SELALU diberitahukan ke client (header
# X-Fallback-Used pada /api/chat & /api/chat/stream), tidak pernah
# diam-diam.
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=ollama

PROVIDER_COOLDOWN_SECONDS=30

# --- Ollama (lokal — TETAP dipertahankan, tidak pernah dihapus) -------
# Sudah dikonfigurasi lewat config/config.json (ollama.host/ollama.model).
# Baris di bawah ini opsional untuk override lewat environment jika
# dibutuhkan di masa depan; belum dipakai oleh app/core/config.py.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# --- NVIDIA AI ---------------------------------------------------------
# API kompatibel OpenAI-style chat completions.
#   1. Buat API key di https://build.nvidia.com (NVIDIA API Catalog).
#   2. Isi baris di bawah ini. Kosongkan jika tidak dipakai — RIN akan
#      melaporkan "belum dikonfigurasi" lewat GET /api/ai/providers,
#      TIDAK crash.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

NVIDIA_TIMEOUT_SECONDS=12
NVIDIA_CONNECT_TIMEOUT_SECONDS=4