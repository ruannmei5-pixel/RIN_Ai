# Contoh file environment variable untuk RIN.
# Salin file ini menjadi ".env" jika diperlukan pada phase-phase berikutnya.
# Jangan pernah mengisi ".env" asli dengan secret dan meng-commit-nya ke Git.

# Contoh (belum digunakan pada Phase 1, disiapkan untuk phase mendatang):
# RIN_OLLAMA_HOST=http://localhost:11434
# RIN_OLLAMA_MODEL=qwen3:4b

# ---------------------------------------------------------------------
# AUTOMATIC WEB SEARCH (Tavily)
# ---------------------------------------------------------------------
# Wajib diisi jika ingin fitur web search otomatis aktif.
# Cara membuat API key:
#   1. Buka https://tavily.com dan buat akun (free tier tersedia).
#   2. Ambil API key dari dashboard (biasanya diawali "tvly-").
#   3. Salin file ini menjadi ".env" (JANGAN commit file ".env" ke Git —
#      sudah otomatis diabaikan lewat .gitignore).
#   4. Isi baris di bawah ini dengan API key Anda.
#
# Jika baris ini kosong/tidak ada, RIN akan otomatis fallback ke Ollama
# tanpa web search (lihat app/services/web_search.py) — TIDAK akan crash.
TAVILY_API_KEY=
